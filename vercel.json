{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/functions/v1/app/(.*)",
      "dest": "/api/app/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.html"
    }
  ],
  "env": {
    "SUPABASE_URL": "https://yeogmpkmztfhcehdfuua.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable__vqqcw2ZJFOY0SFWfYEUzQ_Uc4VbZAG"
  }
}
